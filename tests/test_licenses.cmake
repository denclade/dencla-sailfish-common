cmake_minimum_required(VERSION 3.19)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
string(RANDOM LENGTH 12 ALPHABET abcdef0123456789 token)
set(work "${root}/build/license-test-${token}")
set(source "${work}/source with spaces")
set(binary "${work}/build with spaces")
set(prefix "${work}/install with spaces")
file(MAKE_DIRECTORY "${source}/common/crypto/vendor/monocypher" "${source}/common/crypto/vendor/blake3")
file(COPY "${root}/cmake" "${root}/LICENSE" "${root}/LICENSES" DESTINATION "${source}/common")
configure_file("${root}/crypto/vendor/monocypher/LICENCE.md" "${source}/common/crypto/vendor/monocypher/LICENCE.md" COPYONLY)
configure_file("${root}/crypto/vendor/blake3/LICENSE_CC0" "${source}/common/crypto/vendor/blake3/LICENSE_CC0" COPYONLY)
file(WRITE "${source}/LICENSE" "Application fixture license; unchanged.\n")
file(WRITE "${source}/extra.txt" "Additional fixture license.\n")
file(WRITE "${source}/notices.md" "Additional fixture notices.\n")
set(mit "/* Copyright Fixture; Permission is hereby granted. THE SOFTWARE IS PROVIDED AS IS. */")
set(unlicense "/* This is free and unencumbered software released into the public domain. */")
file(WRITE "${source}/miniz.c" "${mit}\n${mit}\n${unlicense}\n")
file(WRITE "${source}/CMakeLists.txt.in" [=[
cmake_minimum_required(VERSION 3.19)
project(license_fixture NONE)
include("@source@/common/cmake/DenclaLicenses.cmake")
add_custom_target(app_a)
add_custom_target(app_b)
dencla_install_licenses(TARGET app_a APP_NAME "First App")
option(WITH_CRYPTO "Include crypto notices" ON)
set(components BOUNCE_LIST_VIEW MINIZ)
if(WITH_CRYPTO)
    list(APPEND components CRYPTO)
endif()
dencla_install_licenses(TARGET app_b APP_ID second-app APP_NAME "Second App"
    SOURCE_URL "https://example.invalid/project" COMPONENTS ${components}
    MINIZ_SOURCE miniz.c NOTICES_FILE notices.md EXTRA_LICENSE_FILES extra.txt)
]=])
configure_file("${source}/CMakeLists.txt.in" "${source}/CMakeLists.txt" @ONLY)

function(run expected)
    execute_process(COMMAND "${CMAKE_COMMAND}" ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(expected STREQUAL "pass" AND NOT result EQUAL 0)
        message(FATAL_ERROR "License fixture failed: ${stdout}${stderr}")
    elseif(expected STREQUAL "fail" AND result EQUAL 0)
        message(FATAL_ERROR "License fixture unexpectedly succeeded: ${ARGN}")
    endif()
endfunction()

run(pass -S "${source}" -B "${binary}")
run(pass --build "${binary}")
run(pass --install "${binary}" --prefix "${prefix}")
set(first "${prefix}/share/app_a/licenses")
set(second "${prefix}/share/second-app/licenses")
foreach(name APP-LICENSE.txt GPL-3.0-or-later.txt THIRD_PARTY_NOTICES.txt)
    if(NOT EXISTS "${first}/${name}" OR NOT EXISTS "${second}/${name}")
        message(FATAL_ERROR "Installed packages are missing ${name}.")
    endif()
endforeach()
foreach(name BSD-3-Clause-Jolla.txt Monocypher-LICENSE.txt BLAKE3-CC0.txt miniz-NOTICES.txt APP-NOTICES.txt extra.txt)
    if(EXISTS "${first}/${name}" OR NOT EXISTS "${second}/${name}")
        message(FATAL_ERROR "Component isolation failed: ${name}.")
    endif()
endforeach()
foreach(pair "LICENSE|APP-LICENSE.txt" "common/LICENSE|GPL-3.0-or-later.txt"
        "common/LICENSES/BSD-3-Clause.txt|BSD-3-Clause-Jolla.txt"
        "common/crypto/vendor/monocypher/LICENCE.md|Monocypher-LICENSE.txt"
        "common/crypto/vendor/blake3/LICENSE_CC0|BLAKE3-CC0.txt" "extra.txt|extra.txt" "notices.md|APP-NOTICES.txt")
    string(REPLACE "|" ";" pair "${pair}")
    list(GET pair 0 input)
    list(GET pair 1 output)
    file(SHA256 "${source}/${input}" original)
    file(SHA256 "${second}/${output}" installed)
    if(NOT original STREQUAL installed)
        message(FATAL_ERROR "License ${output} was altered during installation.")
    endif()
endforeach()
file(READ "${second}/miniz-NOTICES.txt" notices)
string(FIND "${notices}" "${mit}" position)
if(position EQUAL -1)
    message(FATAL_ERROR "miniz notice was altered or semicolons were lost.")
endif()
string(REPLACE "${mit}" "" remainder "${notices}")
string(LENGTH "${notices}" before)
string(LENGTH "${remainder}" after)
string(LENGTH "${mit}" length)
math(EXPR removed "${before} - ${after}")
if(NOT removed EQUAL length)
    message(FATAL_ERROR "Duplicate miniz notices were not removed.")
endif()

file(APPEND "${source}/miniz.c" "\n/* Copyright Build update; Permission is hereby granted. */\n")
run(pass --build "${binary}" --target app_b)
file(READ "${binary}/CMakeFiles/dencla-licenses-app_b/output/miniz-NOTICES.txt" updated)
if(NOT updated MATCHES "Copyright Build update;")
    message(FATAL_ERROR "Build did not regenerate notices.")
endif()
file(APPEND "${source}/miniz.c" "\n/* Copyright Install update; Permission is hereby granted. */\n")
run(pass --install "${binary}" --prefix "${prefix}")
file(READ "${second}/miniz-NOTICES.txt" updated)
if(NOT updated MATCHES "Copyright Install update;")
    message(FATAL_ERROR "Install did not regenerate notices.")
endif()

run(pass -S "${source}" -B "${binary}" -DWITH_CRYPTO=OFF)
run(pass --install "${binary}" --prefix "${work}/reselected")
if(EXISTS "${work}/reselected/share/second-app/licenses/Monocypher-LICENSE.txt")
    message(FATAL_ERROR "Deselected component notices were still packaged.")
endif()
file(REMOVE "${source}/common/LICENSES/BSD-3-Clause.txt")
run(fail --build "${binary}" --target app_b)
run(fail --install "${binary}" --prefix "${prefix}")
run(fail -S "${source}" -B "${work}/missing-license")
file(REMOVE_RECURSE "${work}")
message(STATUS "Shared license generation, component selection, build and installation passed")
