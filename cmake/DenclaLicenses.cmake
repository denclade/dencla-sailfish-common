include_guard(GLOBAL)

# Serialize literal values, without interpreting quotes, dollar signs or paths.
function(_dencla_license_setting file name value)
    set(equals "=")
    string(FIND "${value}" "]${equals}]" position)
    while(NOT position EQUAL -1)
        string(APPEND equals "=")
        string(FIND "${value}" "]${equals}]" position)
    endwhile()
    file(APPEND "${file}" "set(DENCLA_LICENSE_${name} [${equals}[${value}]${equals}])\n")
endfunction()

function(dencla_install_licenses)
    cmake_parse_arguments(LIC "" "TARGET;APP_ID;APP_NAME;PROJECT_LICENSE;LICENSE_ID;COPYRIGHT;SOURCE_URL;MINIZ_SOURCE;NOTICES_FILE"
        "COMPONENTS;EXTRA_LICENSE_FILES" ${ARGN})
    if(LIC_UNPARSED_ARGUMENTS OR LIC_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "Invalid dencla_install_licenses arguments.")
    endif()
    if(NOT LIC_TARGET OR NOT TARGET "${LIC_TARGET}")
        message(FATAL_ERROR "dencla_install_licenses needs an existing TARGET.")
    endif()
    if(NOT LIC_APP_ID)
        set(LIC_APP_ID "${LIC_TARGET}")
    endif()
    if(NOT LIC_APP_ID MATCHES "^[A-Za-z0-9][A-Za-z0-9_.-]*$")
        message(FATAL_ERROR "License APP_ID must be a single package directory name.")
    endif()
    if(NOT LIC_APP_NAME)
        set(LIC_APP_NAME "${LIC_APP_ID}")
    endif()
    if(NOT LIC_PROJECT_LICENSE)
        set(LIC_PROJECT_LICENSE "${CMAKE_CURRENT_SOURCE_DIR}/LICENSE")
    endif()
    foreach(component IN LISTS LIC_COMPONENTS)
        if(NOT component MATCHES "^(BOUNCE_LIST_VIEW|CRYPTO|MINIZ)$")
            message(FATAL_ERROR "Unknown license component '${component}'.")
        endif()
    endforeach()
    if("MINIZ" IN_LIST LIC_COMPONENTS AND NOT LIC_MINIZ_SOURCE)
        message(FATAL_ERROR "The MINIZ component requires MINIZ_SOURCE.")
    elseif(LIC_MINIZ_SOURCE AND NOT "MINIZ" IN_LIST LIC_COMPONENTS)
        message(FATAL_ERROR "MINIZ_SOURCE requires the MINIZ component.")
    endif()
    foreach(field PROJECT_LICENSE MINIZ_SOURCE NOTICES_FILE)
        if(LIC_${field})
            get_filename_component(LIC_${field} "${LIC_${field}}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
        endif()
    endforeach()
    set(extra "")
    foreach(path IN LISTS LIC_EXTRA_LICENSE_FILES)
        get_filename_component(path "${path}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
        list(APPEND extra "${path}")
    endforeach()
    set(LIC_EXTRA_LICENSE_FILES "${extra}")
    get_filename_component(LIC_COMMON_DIR "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
    set(directory "${CMAKE_CURRENT_BINARY_DIR}/CMakeFiles/dencla-licenses-${LIC_TARGET}")
    file(MAKE_DIRECTORY "${directory}")
    set(LIC_OUTPUT_DIR "${directory}/output")
    set(manifest "${directory}/manifest.cmake")
    file(WRITE "${manifest}" "# Generated license configuration; do not edit.\n")
    foreach(field APP_NAME PROJECT_LICENSE LICENSE_ID COPYRIGHT SOURCE_URL COMPONENTS MINIZ_SOURCE NOTICES_FILE EXTRA_LICENSE_FILES COMMON_DIR OUTPUT_DIR)
        _dencla_license_setting("${manifest}" "${field}" "${LIC_${field}}")
    endforeach()
    set(generator "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/GenerateLicenses.cmake")
    set(command "${CMAKE_COMMAND}" "-DDENCLA_LICENSE_MANIFEST=${manifest}" -P "${generator}")
    execute_process(COMMAND ${command} RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Could not generate licenses for ${LIC_APP_ID}.")
    endif()
    add_custom_target(${LIC_TARGET}-licenses ALL COMMAND ${command}
        COMMENT "Generating license notices for ${LIC_APP_ID}" VERBATIM)
    add_dependencies(${LIC_TARGET} ${LIC_TARGET}-licenses)
    set_property(TARGET ${LIC_TARGET} PROPERTY DENCLA_LICENSE_OUTPUT_DIRECTORY "${LIC_OUTPUT_DIR}")

    # Re-read all upstream files at install time, even without a prior build.
    set(install_script "${directory}/install.cmake")
    file(WRITE "${install_script}" "# Generated license install script.\n")
    _dencla_license_setting("${install_script}" MANIFEST "${manifest}")
    _dencla_license_setting("${install_script}" GENERATOR "${generator}")
    file(APPEND "${install_script}" "include(\"\${DENCLA_LICENSE_GENERATOR}\")\n")
    install(SCRIPT "${install_script}" COMPONENT Licenses)
    # Rapid regeneration may retain the installed file's timestamp. Force
    # copying these notices so an incremental install cannot retain old text.
    install(CODE [=[
        set(_dencla_install_always "$ENV{CMAKE_INSTALL_ALWAYS}")
        set(ENV{CMAKE_INSTALL_ALWAYS} 1)
    ]=] COMPONENT Licenses)
    install(DIRECTORY "${LIC_OUTPUT_DIR}/" DESTINATION "share/${LIC_APP_ID}/licenses"
        COMPONENT Licenses FILES_MATCHING PATTERN "*.txt" PATTERN "index.json")
    install(CODE [=[
        set(ENV{CMAKE_INSTALL_ALWAYS} "${_dencla_install_always}")
        unset(_dencla_install_always)
    ]=] COMPONENT Licenses)
endfunction()
