cmake_minimum_required(VERSION 3.19)

get_filename_component(common "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT DENCLA_LEGAL_DIRECTORY)
    set(DENCLA_LEGAL_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}/legal")
endif()
get_filename_component(DENCLA_LEGAL_DIRECTORY "${DENCLA_LEGAL_DIRECTORY}" ABSOLUTE)
if(NOT DENCLA_LEGAL_CONFIG)
    set(DENCLA_LEGAL_CONFIG "${DENCLA_LEGAL_DIRECTORY}/provider.local.json")
    if(NOT EXISTS "${DENCLA_LEGAL_CONFIG}")
        set(DENCLA_LEGAL_CONFIG "${common}/legal/provider.example.json")
    endif()
endif()
if(NOT EXISTS "${DENCLA_LEGAL_CONFIG}")
    message(FATAL_ERROR "Legal provider configuration does not exist.")
endif()

file(READ "${DENCLA_LEGAL_CONFIG}" profile)
set(missing "")
foreach(field name street postal_code city country email phone)
    string(JSON kind ERROR_VARIABLE error TYPE "${profile}" "${field}")
    if(NOT error STREQUAL "NOTFOUND" OR NOT kind STREQUAL "STRING")
        message(FATAL_ERROR "Legal provider configuration needs a string field '${field}'.")
    endif()
    string(JSON value GET "${profile}" "${field}")
    string(STRIP "${value}" value)
    if(value MATCHES "[\r\n]")
        message(FATAL_ERROR "Legal provider fields must be single-line text.")
    endif()
    if(NOT field STREQUAL "phone" AND (value STREQUAL "" OR value MATCHES "^\\[.*\\]$"))
        list(APPEND missing "${field}")
        set(value "[${field}]")
    endif()
    set(raw_${field} "${value}")
    # Interpolate text, never markup supplied by the publisher.
    string(REPLACE "&" "&amp;" value "${value}")
    string(REPLACE "<" "&lt;" value "${value}")
    string(REPLACE ">" "&gt;" value "${value}")
    string(REPLACE "\"" "&quot;" value "${value}")
    string(REPLACE "'" "&#39;" value "${value}")
    set(legal_${field} "${value}")
endforeach()

if(NOT raw_email MATCHES "^[A-Za-z0-9.!#$%&'*+/=?^_`{|}~-]+@[A-Za-z0-9.-]+\\.[A-Za-z][A-Za-z]+$"
        OR raw_email MATCHES "@example\\.(org|com|net|invalid)$")
    list(APPEND missing "email")
endif()
set(phone_target "${raw_phone}")
string(REPLACE "(0)" "" phone_target "${phone_target}")
string(REGEX REPLACE "[ ()/.-]" "" phone_target "${phone_target}")
if(NOT phone_target STREQUAL "" AND NOT phone_target MATCHES "^\\+?[0-9]+$")
    message(FATAL_ERROR "Legal provider phone must contain a telephone number, not markup.")
endif()
list(REMOVE_DUPLICATES missing)
if(missing AND DENCLA_REQUIRE_LEGAL_DETAILS)
    # Do not echo personal values into CI/build logs.
    list(JOIN missing ", " names)
    message(FATAL_ERROR "Legal provider details incomplete: ${names}. Complete the selected private provider profile before release.")
endif()

if(NOT DENCLA_LEGAL_PRIVACY_TEMPLATE OR NOT EXISTS "${DENCLA_LEGAL_PRIVACY_TEMPLATE}")
    message(FATAL_ERROR "Provide an existing DENCLA_LEGAL_PRIVACY_TEMPLATE for this application.")
endif()
file(READ "${DENCLA_LEGAL_PRIVACY_TEMPLATE}" privacy)
set(privacy_draft FALSE)
if(privacy MATCHES "DENCLA-LEGAL-PRIVACY-DRAFT")
    set(privacy_draft TRUE)
    if(DENCLA_REQUIRE_LEGAL_DETAILS)
        message(FATAL_ERROR "Replace the privacy draft with this application's actual data-processing notice before release.")
    endif()
endif()
if(DENCLA_LEGAL_VALIDATE_ONLY)
    return()
endif()
if(NOT DENCLA_LEGAL_APP_NAME)
    message(FATAL_ERROR "Set DENCLA_LEGAL_APP_NAME when generating documents.")
endif()
set(LEGAL_APPLICATION_NAME "${DENCLA_LEGAL_APP_NAME}")
string(REPLACE "&" "&amp;" LEGAL_APPLICATION_NAME "${LEGAL_APPLICATION_NAME}")
string(REPLACE "<" "&lt;" LEGAL_APPLICATION_NAME "${LEGAL_APPLICATION_NAME}")
string(REPLACE ">" "&gt;" LEGAL_APPLICATION_NAME "${LEGAL_APPLICATION_NAME}")
string(REPLACE "\"" "&quot;" LEGAL_APPLICATION_NAME "${LEGAL_APPLICATION_NAME}")
string(REPLACE "'" "&#39;" LEGAL_APPLICATION_NAME "${LEGAL_APPLICATION_NAME}")
if(NOT DENCLA_LEGAL_IMPRINT_TEMPLATE)
    set(DENCLA_LEGAL_IMPRINT_TEMPLATE "${common}/legal/impressum.html.in")
endif()
if(NOT DENCLA_LEGAL_OUTPUT_DIR)
    set(DENCLA_LEGAL_OUTPUT_DIR "${CMAKE_CURRENT_SOURCE_DIR}/build/legal")
endif()
set(LEGAL_PREVIEW_NOTICE "")
if(missing OR privacy_draft)
    set(LEGAL_PREVIEW_NOTICE "<p><b>Entwicklungsfassung: Anbieterangaben oder Datenschutzhinweise sind noch unvollständig. Diese Fassung ist nicht zur Veröffentlichung bestimmt.</b></p>")
endif()
set(LEGAL_CONTACT_HTML "<p>${legal_name}<br>${legal_street}<br>${legal_postal_code} ${legal_city}<br>${legal_country}</p><p>E-Mail: <a href=\"mailto:${legal_email}\">${legal_email}</a>")
if(NOT phone_target STREQUAL "")
    string(APPEND LEGAL_CONTACT_HTML "<br>Telefon: <a href=\"tel:${phone_target}\">${legal_phone}</a>")
endif()
string(APPEND LEGAL_CONTACT_HTML "</p>")
file(MAKE_DIRECTORY "${DENCLA_LEGAL_OUTPUT_DIR}")
configure_file("${DENCLA_LEGAL_IMPRINT_TEMPLATE}" "${DENCLA_LEGAL_OUTPUT_DIR}/impressum.html" @ONLY)
configure_file("${DENCLA_LEGAL_PRIVACY_TEMPLATE}" "${DENCLA_LEGAL_OUTPUT_DIR}/datenschutz.html" @ONLY)
