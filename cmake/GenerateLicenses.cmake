cmake_minimum_required(VERSION 3.19)
if(NOT DENCLA_LICENSE_MANIFEST OR NOT EXISTS "${DENCLA_LICENSE_MANIFEST}")
    message(FATAL_ERROR "Provide an existing DENCLA_LICENSE_MANIFEST.")
endif()
include("${DENCLA_LICENSE_MANIFEST}")

# string(JSON SET) expects each value to already be valid JSON.
function(_dencla_json_quote output value)
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    string(REPLACE "\n" "\\n" value "${value}")
    string(REPLACE "\r" "\\r" value "${value}")
    string(REPLACE "\t" "\\t" value "${value}")
    set(${output} "\"${value}\"" PARENT_SCOPE)
endfunction()

function(_dencla_license_entry output name license url)
    set(entry "{}")
    foreach(field name license url)
        _dencla_json_quote(value "${${field}}")
        string(JSON entry SET "${entry}" "${field}" "${value}")
    endforeach()
    set(files "[]")
    set(position 0)
    foreach(file IN LISTS ARGN)
        _dencla_json_quote(value "${file}")
        string(JSON files SET "${files}" ${position} "${value}")
        math(EXPR position "${position} + 1")
    endforeach()
    string(JSON entry SET "${entry}" files "${files}")
    set(${output} "${entry}" PARENT_SCOPE)
endfunction()

function(dencla_generate_licenses)
    if(NOT DENCLA_LICENSE_OUTPUT_DIR OR NOT DENCLA_LICENSE_COMMON_DIR OR NOT DENCLA_LICENSE_PROJECT_LICENSE)
        message(FATAL_ERROR "Incomplete license manifest.")
    endif()
    set(output "${DENCLA_LICENSE_OUTPUT_DIR}")
    set(common "${DENCLA_LICENSE_COMMON_DIR}")
    file(MAKE_DIRECTORY "${output}")
    # This directory is owned by the helper. Remove obsolete component files
    # when an app changes its selection between configurations.
    file(GLOB previous "${output}/*.txt")
    if(previous)
        file(REMOVE ${previous})
    endif()
    configure_file("${DENCLA_LICENSE_PROJECT_LICENSE}" "${output}/APP-LICENSE.txt" COPYONLY)
    configure_file("${common}/LICENSE" "${output}/GPL-3.0-or-later.txt" COPYONLY)
    file(SHA256 "${output}/APP-LICENSE.txt" app_hash)
    file(SHA256 "${output}/GPL-3.0-or-later.txt" shared_hash)
    if(app_hash STREQUAL shared_hash)
        # Keep the stable application filename without shipping the GPL twice.
        file(REMOVE "${output}/APP-LICENSE.txt")
        file(CREATE_LINK "GPL-3.0-or-later.txt" "${output}/APP-LICENSE.txt" SYMBOLIC)
    endif()
    set(index "{\"version\":1,\"application\":{},\"components\":[]}")
    foreach(pair "name|APP_NAME" "license|LICENSE_ID" "copyright|COPYRIGHT" "url|SOURCE_URL")
        string(REPLACE "|" ";" pair "${pair}")
        list(GET pair 0 key)
        list(GET pair 1 field)
        _dencla_json_quote(value "${DENCLA_LICENSE_${field}}")
        string(JSON index SET "${index}" application "${key}" "${value}")
    endforeach()
    _dencla_license_entry(entry "dencla-sailfish-common" "GPL-3.0-or-later"
        "https://github.com/denclade/dencla-sailfish-common" GPL-3.0-or-later.txt)
    string(JSON index SET "${index}" components 0 "${entry}")
    set(position 1)
    set(summary "${DENCLA_LICENSE_APP_NAME}\n\nApplication license: APP-LICENSE.txt\n")
    if(DENCLA_LICENSE_SOURCE_URL)
        string(APPEND summary "Application source: ${DENCLA_LICENSE_SOURCE_URL}\n")
    endif()
    string(APPEND summary "\ndencla-sailfish-common: GPL-3.0-or-later.\nFull license: GPL-3.0-or-later.txt\nSource: https://github.com/denclade/dencla-sailfish-common\n")
    if("BOUNCE_LIST_VIEW" IN_LIST DENCLA_LICENSE_COMPONENTS)
        configure_file("${common}/LICENSES/BSD-3-Clause.txt" "${output}/BSD-3-Clause-Jolla.txt" COPYONLY)
        _dencla_license_entry(entry "BounceListView" "BSD-3-Clause" "" BSD-3-Clause-Jolla.txt)
        string(JSON index SET "${index}" components ${position} "${entry}")
        math(EXPR position "${position} + 1")
        string(APPEND summary "\nBounceListView.qml contains the Silica opacity formula by Jolla Ltd. (2013).\nFull BSD-3-Clause copyright notice, terms and disclaimer: BSD-3-Clause-Jolla.txt\n")
    endif()
    if("CRYPTO" IN_LIST DENCLA_LICENSE_COMPONENTS)
        configure_file("${common}/crypto/vendor/monocypher/LICENCE.md" "${output}/Monocypher-LICENSE.txt" COPYONLY)
        configure_file("${common}/crypto/vendor/blake3/LICENSE_CC0" "${output}/BLAKE3-CC0.txt" COPYONLY)
        _dencla_license_entry(entry Monocypher "BSD-2-Clause OR CC0-1.0" "https://monocypher.org" Monocypher-LICENSE.txt)
        string(JSON index SET "${index}" components ${position} "${entry}")
        math(EXPR position "${position} + 1")
        _dencla_license_entry(entry BLAKE3 "CC0-1.0" "https://github.com/BLAKE3-team/BLAKE3" BLAKE3-CC0.txt)
        string(JSON index SET "${index}" components ${position} "${entry}")
        math(EXPR position "${position} + 1")
        string(APPEND summary "\nMonocypher: BSD-2-Clause OR CC0-1.0. Full upstream notices: Monocypher-LICENSE.txt\nBLAKE3: this distribution selects CC0-1.0. Full text: BLAKE3-CC0.txt\n")
    endif()
    if("MINIZ" IN_LIST DENCLA_LICENSE_COMPONENTS)
        # Extract entire upstream license comments, including their copyright
        # holders. Do not replace these with generic license templates. Process
        # one comment at a time so semicolons in source remain literal text.
        file(READ "${DENCLA_LICENSE_MINIZ_SOURCE}" source)
        set(notices "miniz: license notices from the bundled miniz.c\n\n")
        set(seen "")
        set(found_mit FALSE)
        set(found_unlicense FALSE)
        while(TRUE)
            string(FIND "${source}" "/*" start)
            if(start EQUAL -1)
                break()
            endif()
            string(SUBSTRING "${source}" ${start} -1 source)
            string(FIND "${source}" "*/" end)
            if(end EQUAL -1)
                message(FATAL_ERROR "Unterminated comment in bundled miniz.c.")
            endif()
            math(EXPR length "${end} + 2")
            string(SUBSTRING "${source}" 0 ${length} comment)
            string(SUBSTRING "${source}" ${length} -1 source)
            if(comment MATCHES "Permission is hereby granted")
                set(found_mit TRUE)
            elseif(comment MATCHES "This is free and unencumbered software")
                set(found_unlicense TRUE)
            else()
                continue()
            endif()
            string(SHA256 digest "${comment}")
            if(NOT digest IN_LIST seen)
                list(APPEND seen "${digest}")
                string(APPEND notices "${comment}\n\n")
            endif()
        endwhile()
        if(NOT found_mit OR NOT found_unlicense)
            message(FATAL_ERROR "Expected MIT and public-domain notices in bundled miniz.c; review its licenses before distributing.")
        endif()
        file(WRITE "${output}/miniz-NOTICES.txt" "${notices}")
        _dencla_license_entry(entry miniz "MIT / public domain" "https://github.com/richgel999/miniz" miniz-NOTICES.txt)
        string(JSON index SET "${index}" components ${position} "${entry}")
        math(EXPR position "${position} + 1")
        string(APPEND summary "\nminiz: complete upstream MIT and public-domain notices: miniz-NOTICES.txt\nUpstream: https://github.com/richgel999/miniz\n")
    endif()
    if(DENCLA_LICENSE_NOTICES_FILE)
        configure_file("${DENCLA_LICENSE_NOTICES_FILE}" "${output}/APP-NOTICES.txt" COPYONLY)
        _dencla_license_entry(entry "${DENCLA_LICENSE_APP_NAME}" "" "" APP-NOTICES.txt)
        string(JSON entry SET "${entry}" kind "\"application-notices\"")
        string(JSON index SET "${index}" components ${position} "${entry}")
        math(EXPR position "${position} + 1")
        string(APPEND summary "\nAdditional application notices: APP-NOTICES.txt\n")
    endif()
    set(names APP-LICENSE.txt GPL-3.0-or-later.txt BSD-3-Clause-Jolla.txt
        Monocypher-LICENSE.txt BLAKE3-CC0.txt miniz-NOTICES.txt APP-NOTICES.txt THIRD_PARTY_NOTICES.txt)
    foreach(path IN LISTS DENCLA_LICENSE_EXTRA_LICENSE_FILES)
        get_filename_component(name "${path}" NAME)
        if(NOT name MATCHES "^[A-Za-z0-9][A-Za-z0-9_. -]*\\.txt$" OR name IN_LIST names)
            message(FATAL_ERROR "Extra license files need unique .txt basenames: ${name}")
        endif()
        list(APPEND names "${name}")
        configure_file("${path}" "${output}/${name}" COPYONLY)
        _dencla_license_entry(entry "${name}" "" "" "${name}")
        string(JSON index SET "${index}" components ${position} "${entry}")
        math(EXPR position "${position} + 1")
        string(APPEND summary "\nAdditional license: ${name}\n")
    endforeach()
    file(WRITE "${output}/THIRD_PARTY_NOTICES.txt" "${summary}")
    # Publish the catalog only after all referenced files were generated.
    file(WRITE "${output}/index.json" "${index}\n")
endfunction()

dencla_generate_licenses()
